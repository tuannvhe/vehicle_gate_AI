# Sao chép thành .env rồi chỉnh theo máy chạy thật

# Backend .NET nhận kết quả AI
WEBHOOK_URL=https://localhost:7069/api/ai/webhook/result
# false khi backend dùng chứng chỉ tự ký trong mạng nội bộ
BACKEND_VERIFY_SSL=false

# Đọc cả 2 dòng biển số
READ_FULL_PLATE=true

# API thử nghiệm (/api/test-batch) - KHÔNG bật trên máy chạy thật
ENABLE_TEST_ENDPOINTS=false
